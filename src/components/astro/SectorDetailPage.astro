---
import ScoreBadgeStatic from "./ScoreBadgeStatic.astro";
import type { SectorStat } from "@/data/loadOccupations";
import { occupationSlugFor, sectorSlugFor } from "@/data/loadOccupations";
import type { RawOccupation } from "@/lib/occupationData";
import { strings, sectorLabel, type Lang } from "@/i18n/static";

interface Props {
  sector: SectorStat;
  enByCno: Map<string, RawOccupation>;
  lang: Lang;
}

const { sector, enByCno, lang } = Astro.props;
const t = strings(lang);
const localeStr = lang === "en" ? "en-US" : "es-ES";
const decimalChar = lang === "en" ? "." : ",";
const occBase = t.paths.ocupacionPrefix;
const sectorBase = t.paths.sectorPrefix;

const sectorName = sectorLabel(sector.sector, lang);
const sorted = [...sector.occupations].sort((a, b) => b.vulnerabilidad_ia_score - a.vulnerabilidad_ia_score);

const F = "'DM Sans', sans-serif";
const S = "'Cormorant Garamond', serif";

const fmtScore = (n: number) => n.toString().replace(".", decimalChar);
const displayName = (d: RawOccupation): string =>
  lang === "en" ? (enByCno.get(d.cno)?.nombre ?? d.nombre) : d.nombre;
const displayEuAct = (d: RawOccupation): string =>
  lang === "en" ? (enByCno.get(d.cno)?.eu_ai_act ?? d.eu_ai_act) : d.eu_ai_act;
---

<div style={`background:#faf8f4;color:#1a1a1a;min-height:100vh;font-family:${F};`}>
  <article style="max-width:1200px;margin:0 auto;padding:28px 24px;">

    <!-- Breadcrumb -->
    <nav style="font-size:10px;text-transform:uppercase;letter-spacing:2.5px;color:#bbb;margin-bottom:6px;">
      <a href={t.paths.root} style="color:#c8633a;text-decoration:none;">{t.common.breadcrumbHome}</a>
      <span style="margin:0 4px;">›</span>
      <a href={t.paths.sectorIndex} style="color:#c8633a;text-decoration:none;">{t.common.breadcrumbSectors}</a>
      <span style="margin:0 4px;">›</span>
      <span>{sectorName}</span>
    </nav>

    <!-- Header -->
    <h1 style={`font-size:clamp(26px,3.5vw,44px);font-family:${S};font-weight:600;margin:0 0 4px;line-height:1.08;color:#1a1a1a;`}>
      {sectorName}
    </h1>
    <p style="font-size:14px;color:#888;line-height:1.55;margin:0 0 20px;">
      {t.sectorDetail.subline(sector.count, sector.employment.toLocaleString(localeStr), fmtScore(sector.avgScore))}
    </p>

    <!-- Stats ribbon -->
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorIndex.cardOccupations}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>{sector.count}</div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorDetail.employmentTotal}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>
          {sector.employment >= 1e6 ? (sector.employment / 1e6).toLocaleString(localeStr, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "M" : sector.employment.toLocaleString(localeStr)}
        </div>
        <div style="font-size:10px;color:#b08050;margin-top:2px;font-style:italic;">{t.sectorDetail.epaSource}</div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorDetail.exposureIA}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>{fmtScore(sector.avgScore)} / 10</div>
        <div style="font-size:10px;color:#b08050;margin-top:2px;font-style:italic;">{t.sectorDetail.employmentWeighted}</div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.common.avgSalary}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>
          {sector.avgSalary.toLocaleString(localeStr)} €
        </div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorDetail.highRiskShort}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#c8633a;`}>
          {sector.highRiskCount}
        </div>
        <div style="font-size:11px;color:#999;margin-top:2px;">{t.sectorDetail.scoreGt}</div>
      </div>
    </div>

    <!-- Note -->
    <div style="font-size:10px;color:#b08050;background:#fdf6ee;border:1px solid #f0dcc0;border-radius:5px;padding:8px 12px;margin-bottom:20px;line-height:1.5;">
      <strong>{t.sectorDetail.note}</strong> {t.sectorDetail.noteText}
    </div>

    <!-- Occupations list -->
    <div style="display:flex;flex-direction:column;gap:2px;">
      <div style="display:grid;grid-template-columns:40px 1fr 110px 90px 90px 90px;gap:6px;padding:6px 10px;font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#bbb;font-weight:600;border-bottom:1px solid #e8e4dc;">
        <div>{t.common.score}</div>
        <div>{t.common.occupation}</div>
        <div>{t.common.cno}</div>
        <div style="text-align:right;">{t.common.employment}</div>
        <div style="text-align:right;">{t.common.avgSalary}</div>
        <div style="text-align:right;">{t.common.euAct}</div>
      </div>
      {sorted.map((occ, i) => {
        const enOcc = enByCno.get(occ.cno);
        const slug = occupationSlugFor(occ, enOcc, lang);
        const label = displayName(occ);
        const euActText = displayEuAct(occ);
        const isHigh = euActText.toLowerCase().includes("alto") || euActText.toLowerCase().includes("high");
        const isLim = euActText.toLowerCase().includes("limitado") || euActText.toLowerCase().includes("limited");
        const euBg = isHigh ? "#c8633a15" : isLim ? "#d4a85a15" : "#3a7d9e15";
        const euFg = isHigh ? "#c8633a" : isLim ? "#d4a85a" : "#3a7d9e";
        return (
          <a href={`${occBase}/${slug}`} style={`display:grid;grid-template-columns:40px 1fr 110px 90px 90px 90px;gap:6px;padding:8px 10px;font-size:12px;background:${i % 2 === 0 ? "#f5f1eb" : "transparent"};border-radius:4px;text-decoration:none;color:#1a1a1a;align-items:center;`}>
            <div><ScoreBadgeStatic score={occ.vulnerabilidad_ia_score} /></div>
            <div><div style="font-weight:600;color:#1a1a1a;">{label}</div></div>
            <div style="font-size:10px;color:#bbb;">{occ.cno}</div>
            <div style="text-align:right;color:#555;font-variant-numeric:tabular-nums;">{occ.empleo.toLocaleString(localeStr)}</div>
            <div style="text-align:right;color:#555;font-variant-numeric:tabular-nums;">{occ.salario_medio_eur.toLocaleString(localeStr)} €</div>
            <div style="text-align:right;">
              <span style={`font-size:9px;padding:2px 7px;border-radius:8px;background:${euBg};color:${euFg};font-weight:600;`}>{euActText}</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Footer -->
    <div style="margin-top:24px;padding-top:16px;border-top:1px solid #e8e4dc;">
      <div style="font-size:10px;color:#bbb;line-height:1.65;">
        <strong style="color:#999;">{t.common.source}</strong> {t.common.sourceLine}
        {t.common.authorsLine}
      </div>
    </div>
  </article>
</div>
