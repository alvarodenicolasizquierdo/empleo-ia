---
import ScoreBadgeStatic from "./ScoreBadgeStatic.astro";
import type { RawOccupation } from "@/lib/occupationData";
import { SCORE_COLORS } from "@/lib/occupationData";
import { sectorSlugFor } from "@/data/loadOccupations";
import { strings, sectorLabel, type Lang } from "@/i18n/static";

interface Props {
  occ: RawOccupation;
  en: RawOccupation;
  lang: Lang;
}

const { occ, en, lang } = Astro.props;
const t = strings(lang);
const localeStr = lang === "en" ? "en-US" : "es-ES";
const decimalChar = lang === "en" ? "." : ",";
const sectorBase = t.paths.sectorPrefix;
const occBase = t.paths.ocupacionPrefix;

const score = occ.vulnerabilidad_ia_score;
const colorIndex = Math.round(Math.min(10, Math.max(0, score)));
const scoreColor = SCORE_COLORS[colorIndex];

const fmtScore = (n: number) => n.toString().replace(".", decimalChar);
const occName = lang === "en" ? en.nombre : occ.nombre;
const altName = lang === "en" ? occ.nombre : en.nombre;
const sectorName = sectorLabel(occ.sector, lang);
const euAct = lang === "en" ? (en.eu_ai_act ?? occ.eu_ai_act) : occ.eu_ai_act;
const tipoImpacto = lang === "en" ? (en.tipo_impacto ?? occ.tipo_impacto) : occ.tipo_impacto;
const justificacion = lang === "en" ? en.justificacion : occ.justificacion;
const altJustificacion = lang === "en" ? occ.justificacion : en.justificacion;

const wageIndex = occ.empleo * occ.salario_medio_eur * (score / 10);
const wageLabel = wageIndex >= 1e9
  ? (wageIndex / 1e9).toLocaleString(localeStr, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "B €"
  : (wageIndex / 1e6).toLocaleString(localeStr, { maximumFractionDigits: 0 }) + "M €";

const levelLabel = score >= 8 ? t.occupation.levelVeryHigh
  : score >= 6 ? t.occupation.levelHigh
  : score >= 4 ? t.occupation.levelModerate
  : score >= 2 ? t.occupation.levelLow
  : t.occupation.levelVeryLow;

const F = "'DM Sans', sans-serif";
const S = "'Cormorant Garamond', serif";
---

<div style={`background:#faf8f4;color:#1a1a1a;min-height:100vh;font-family:${F};`}>
  <article style="max-width:900px;margin:0 auto;padding:28px 24px;">

    <!-- Breadcrumb -->
    <nav style="font-size:10px;text-transform:uppercase;letter-spacing:2px;color:#bbb;margin-bottom:6px;">
      <a href={t.paths.root} style="color:#c8633a;text-decoration:none;">{t.common.breadcrumbHome}</a>
      <span style="margin:0 4px;">›</span>
      <a href={t.paths.sectorIndex} style="color:#c8633a;text-decoration:none;">{t.common.breadcrumbSectors}</a>
      <span style="margin:0 4px;">›</span>
      <a href={`${sectorBase}/${sectorSlugFor(occ.sector, lang)}`} style="color:#c8633a;text-decoration:none;">{sectorName}</a>
      <span style="margin:0 4px;">›</span>
      <span>{t.common.cno} {occ.cno}</span>
    </nav>

    <!-- Header -->
    <h1 style={`font-size:clamp(26px,3.5vw,44px);font-family:${S};font-weight:600;margin:0 0 4px;line-height:1.08;color:#1a1a1a;`}>
      {occName}
    </h1>
    <p style="font-size:14px;color:#888;margin:0 0 20px;font-style:italic;">
      {altName}
    </p>

    <!-- Score -->
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;">
      <ScoreBadgeStatic score={score} size="lg" />
      <div>
        <div style={`font-size:15px;font-weight:600;color:${scoreColor};`}>
          {t.occupation.exposureLabel} {levelLabel}
        </div>
        <div style="font-size:12px;color:#888;">{fmtScore(score)} / 10</div>
        <div style="font-size:10px;color:#b08050;margin-top:2px;font-style:italic;">{t.occupation.theoreticalCaveat}</div>
      </div>
    </div>

    <!-- Stats ribbon -->
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
      <div style="padding:14px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.common.employees}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>
          {occ.empleo >= 1e6 ? (occ.empleo / 1e6).toLocaleString(localeStr, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "M" : occ.empleo >= 1e3 ? Math.round(occ.empleo / 1e3) + "K" : occ.empleo.toLocaleString(localeStr)}
        </div>
      </div>
      <div style="padding:14px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.common.avgSalary}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>
          {occ.salario_medio_eur.toLocaleString(localeStr)} €
        </div>
      </div>
      <div style="padding:14px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.occupation.wageIndexLabel}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#c8633a;`}>
          {wageLabel}
        </div>
        <div style="font-size:10px;color:#c8633a;margin-top:2px;font-weight:600;">{t.occupation.wageFormula}</div>
      </div>
    </div>

    <!-- D/C/F/R sub-component breakdown -->
    {occ.rescore_D != null && (
      <div style="margin-bottom:20px;padding:16px;background:#f0ece4;border-radius:8px;border:1px solid #e0dcd4;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#999;margin-bottom:12px;font-weight:600;">
          {t.occupation.subcomponentsTitle}
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {[
            { key: "D", label: t.occupation.dLabel, value: occ.rescore_D!, color: "#b04232" },
            { key: "C", label: t.occupation.cLabel, value: occ.rescore_C!, color: "#d4a85a" },
            { key: "F", label: t.occupation.fLabel, value: occ.rescore_F!, color: "#3a7d9e" },
            { key: "R", label: t.occupation.rLabel, value: occ.rescore_R!, color: "#5494ab" },
          ].map((b) => (
            <div style="display:flex;align-items:center;gap:10px;">
              <div style={`width:14px;font-size:12px;font-weight:700;color:${b.color};text-align:center;flex-shrink:0;`}>{b.key}</div>
              <div style="flex:1;min-width:0;">
                <div style="display:flex;justify-content:space-between;margin-bottom:2px;">
                  <span style="font-size:10px;color:#666;">{b.label}</span>
                  <span style={`font-size:11px;font-weight:700;color:#1a1a1a;font-family:${S};`}>{fmtScore(b.value)}</span>
                </div>
                <div style="height:6px;background:#e0dcd4;border-radius:3px;overflow:hidden;">
                  <div style={`height:100%;width:${(b.value / 10) * 100}%;background:${b.color};border-radius:3px;`} />
                </div>
              </div>
            </div>
          ))}
        </div>
        {occ.rescore_formula && (
          <div style="margin-top:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
            <span style="font-size:10px;color:#888;">
              {t.occupation.formula} <code style="font-size:10px;background:#e8e4dc;padding:1px 5px;border-radius:3px;">{occ.rescore_formula}</code>
            </span>
            {occ.score_v9 != null && (
              <span style="font-size:10px;color:#888;font-weight:600;">
                {t.occupation.rescored(fmtScore(+occ.score_v9.toFixed(1)), fmtScore(+score.toFixed(1)))}
              </span>
            )}
          </div>
        )}
      </div>
    )}

    <!-- Automation vector (primary language) -->
    <div style="margin-bottom:16px;">
      <div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#999;margin-bottom:6px;">{t.occupation.vectorTitle}</div>
      <div style={`font-size:13px;color:#444;line-height:1.5;padding:10px;background:#f0ece4;border-radius:5px;border-left:3px solid ${scoreColor};`}>
        {justificacion}
      </div>
    </div>

    <!-- Automation vector (alt language) -->
    <div style="margin-bottom:16px;">
      <div style="font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#999;margin-bottom:6px;">{t.occupation.vectorEnTitle}</div>
      <div style="font-size:13px;color:#666;line-height:1.5;padding:10px;background:#f0ece4;border-radius:5px;">
        {altJustificacion}
      </div>
    </div>

    <!-- Impact type + EU AI Act -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:16px;">
      <span style="padding:4px 12px;border-radius:16px;font-size:11px;font-weight:600;background:#f0ece4;color:#666;border:1px solid #e0dcd4;">
        {tipoImpacto}
      </span>
      <span style={`padding:4px 12px;border-radius:16px;font-size:11px;font-weight:600;background:${scoreColor}18;color:${scoreColor};border:1px solid ${scoreColor}33;`}>
        {t.common.euAct}: {euAct}
      </span>
      {occ.employment_confidence && (
        <span style={`padding:4px 12px;border-radius:16px;font-size:11px;font-weight:600;background:${occ.employment_confidence === "A+" ? "#3a7d9e22" : occ.employment_confidence === "A" ? "#5494ab22" : "#d4a85a22"};color:${occ.employment_confidence === "A+" ? "#2b6a8e" : occ.employment_confidence === "A" ? "#3a7d9e" : "#b08050"};`}>
          {t.occupation.employmentConfidence} {occ.employment_confidence}
        </span>
      )}
    </div>

    <!-- CTA -->
    <div style="margin-top:24px;padding-top:16px;border-top:1px solid #e8e4dc;">
      <a href={`${t.paths.root}?cno=${occ.cno}`} style={`display:inline-flex;align-items:center;gap:6px;padding:7px 14px;font-size:11px;font-weight:600;font-family:${F};background:#1a1a1a;color:#faf8f4;border-radius:5px;text-decoration:none;letter-spacing:0.3px;`}>
        {t.occupation.ctaDashboard}
      </a>
    </div>

    <!-- Footer -->
    <div style="margin-top:20px;font-size:10px;color:#bbb;line-height:1.65;">
      <strong style="color:#999;">{t.common.source}</strong> {t.common.sourceLine}
      {t.common.authorsLine}
    </div>
  </article>
</div>
