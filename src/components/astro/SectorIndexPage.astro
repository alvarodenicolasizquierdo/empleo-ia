---
/**
 * Body of the /sector/ index, parameterised by language so the same template
 * powers both `/sector/` (es) and `/en/sector/` (en).
 */
import { SCORE_COLORS } from "@/lib/occupationData";
import { loadAllOccupations, getSectorStats, getAggregateStats, sectorSlugFor } from "@/data/loadOccupations";
import { strings, sectorLabel, type Lang } from "@/i18n/static";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang);
const localeStr = lang === "en" ? "en-US" : "es-ES";
const sectorBase = t.paths.sectorPrefix;

const { es } = loadAllOccupations();
const sectors = getSectorStats(es);
const stats = getAggregateStats(es);
const sorted = [...sectors].sort((a, b) => b.avgScore - a.avgScore);

const employmentFmt = stats.totalEmployment.toLocaleString(localeStr);
const avgScoreFmt = stats.avgScore.toString().replace(".", lang === "en" ? "." : ",");

const F = "'DM Sans', sans-serif";
const S = "'Cormorant Garamond', serif";
---

<div style={`background:#faf8f4;color:#1a1a1a;min-height:100vh;font-family:${F};`}>
  <div style="max-width:1200px;margin:0 auto;padding:28px 24px;">

    <!-- Breadcrumb -->
    <nav style="font-size:10px;text-transform:uppercase;letter-spacing:2.5px;color:#bbb;margin-bottom:6px;">
      <a href={t.paths.root} style="color:#c8633a;text-decoration:none;">{t.common.breadcrumbMap}</a>
    </nav>

    <!-- Header -->
    <h1 style={`font-size:clamp(26px,3.5vw,44px);font-family:${S};font-weight:600;margin:0 0 4px;line-height:1.08;color:#1a1a1a;`}>
      {t.sectorIndex.h1}
    </h1>
    <p style="font-size:14px;color:#888;line-height:1.55;margin:0 0 20px;">
      {t.sectorIndex.subline(sectors.length, es.length, employmentFmt, avgScoreFmt)}
    </p>

    <!-- Stats ribbon -->
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px;">
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorIndex.totalWorkers}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>
          {(stats.totalEmployment / 1e6).toLocaleString(localeStr, { minimumFractionDigits: 1, maximumFractionDigits: 1 })}M
        </div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorIndex.avgExposure}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#1a1a1a;`}>{avgScoreFmt} / 10</div>
      </div>
      <div style="padding:12px 16px;background:#f0ece4;border-radius:6px;flex:1 1 150px;min-width:140px;">
        <div style="font-size:9px;text-transform:uppercase;letter-spacing:1.3px;color:#aaa;margin-bottom:4px;">{t.sectorIndex.highRisk}</div>
        <div style={`font-size:22px;font-weight:700;font-family:${S};line-height:1.1;color:#c8633a;`}>
          {stats.highRiskCount} {t.sectorIndex.occShort}
        </div>
        <div style="font-size:11px;color:#999;margin-top:2px;">{t.sectorIndex.ofEmployment(stats.highRiskPct.toString().replace(".", lang === "en" ? "." : ","))}</div>
      </div>
    </div>

    <!-- Sector cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px;">
      {sorted.map((s) => {
        const colorIdx = Math.round(Math.min(10, Math.max(0, s.avgScore)));
        const color = SCORE_COLORS[colorIdx];
        const empLabel = s.employment >= 1e6
          ? (s.employment / 1e6).toLocaleString(localeStr, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "M"
          : s.employment >= 1e3 ? Math.round(s.employment / 1e3) + "K" : s.employment.toLocaleString(localeStr);
        const label = sectorLabel(s.sector, lang);
        return (
          <a href={`${sectorBase}/${sectorSlugFor(s.sector, lang)}`} style="text-decoration:none;display:block;padding:20px;background:#f0ece4;border-radius:8px;border:1px solid #e0dcd4;transition:box-shadow 0.15s;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
              <h2 style={`font-size:18px;font-family:${S};font-weight:600;margin:0;color:#1a1a1a;line-height:1.2;`}>{label}</h2>
              <div style={`width:36px;height:36px;border-radius:50%;background:${color};display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;flex-shrink:0;box-shadow:0 2px 8px ${color}44;`}>
                {s.avgScore}
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:10px;">
              <div>
                <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.8px;color:#aaa;">{t.sectorIndex.cardOccupations}</div>
                <div style={`font-size:16px;font-weight:700;font-family:${S};color:#1a1a1a;`}>{s.count}</div>
              </div>
              <div>
                <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.8px;color:#aaa;">{t.sectorIndex.cardEmployment}</div>
                <div style={`font-size:16px;font-weight:700;font-family:${S};color:#1a1a1a;`}>{empLabel}</div>
              </div>
              <div>
                <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.8px;color:#aaa;">{t.sectorIndex.cardSalary}</div>
                <div style={`font-size:16px;font-weight:700;font-family:${S};color:#1a1a1a;`}>{s.avgSalary.toLocaleString(localeStr)} €</div>
              </div>
            </div>
            {s.highRiskCount > 0 && (
              <div style="font-size:10px;color:#c8633a;font-weight:600;">
                {t.sectorIndex.cardHighRisk(s.highRiskCount)}
              </div>
            )}
          </a>
        );
      })}
    </div>

    <!-- Footer -->
    <div style="margin-top:24px;padding-top:16px;border-top:1px solid #e8e4dc;">
      <div style="font-size:10px;color:#bbb;line-height:1.65;">
        <strong style="color:#999;">{t.common.source}</strong> {t.common.sourceLine}
        {t.common.authorsLine}
      </div>
    </div>
  </div>
</div>
