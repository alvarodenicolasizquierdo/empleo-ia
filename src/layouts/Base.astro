---
import { SITE } from "../config/site";
import { LOCALES, type Lang } from "../i18n/static";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Active language for the rendered page. Defaults to "es" for backwards compat. */
  lang?: Lang;
  /** Path of the equivalent mirror page in the other language. Used for hreflang + og:locale:alternate. */
  altLangHref?: string;
}

const { title, description, canonical, ogImage, jsonLd, noindex, lang = "es", altLangHref } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const image = ogImage || new URL(lang === "en" ? "/og-image-en.png" : "/og-image.png", Astro.site).href;
const locale = LOCALES[lang];
const altLang: Lang = lang === "en" ? "es" : "en";
const altLocale = LOCALES[altLang];
const altHrefAbs = altLangHref ? new URL(altLangHref, Astro.site).href : undefined;
const siteName = lang === "en"
  ? "Labour Vulnerability to AI · Spain 2026"
  : "Vulnerabilidad Laboral a la IA · España 2026";

// Normalize jsonLd to array
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang={locale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Álvaro de Nicolás, Miguel Sureda" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Search engine ownership verification (managed in src/config/site.ts) -->
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    {SITE.bingSiteVerification && (
      <meta name="msvalidate.01" content={SITE.bingSiteVerification} />
    )}

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Language variants — real hreflang only when an alt mirror exists for this page. -->
    <link rel="alternate" hreflang={locale.htmlLang} href={canonicalUrl} />
    {altHrefAbs && (
      <link rel="alternate" hreflang={altLocale.htmlLang} href={altHrefAbs} />
    )}
    {altHrefAbs && (
      <link rel="alternate" hreflang="x-default" href={lang === "es" ? canonicalUrl : altHrefAbs} />
    )}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:locale:alternate" content={altLocale.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Alternate data formats -->
    <link rel="alternate" type="application/json" href={lang === "en" ? "/data/spain_502_v15_subcomp_complete_en.json" : "/data/spain_502_v15_subcomp_complete.json"} />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" />

    <!-- Structured Data -->
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- Analytics -->
    {SITE.umamiWebsiteId && SITE.umamiSrc && (
      <script defer src={SITE.umamiSrc} data-website-id={SITE.umamiWebsiteId}></script>
    )}

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Persist server-rendered language so the React island agrees on first paint,
         and expose the alt-language mirror URL so LanguageToggle can navigate to it. -->
    <script is:inline define:vars={{ pageLang: lang, altHref: altLangHref ?? null }}>
      try { localStorage.setItem("lang", pageLang); } catch {}
      window.__pageLang = pageLang;
      window.__altLangHref = altHref;
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
