---
import Base from "../../../layouts/Base.astro";
import SectorIndexPage from "../../../components/astro/SectorIndexPage.astro";
import { loadAllOccupations, getSectorStats, getAggregateStats, sectorSlugFor } from "@/data/loadOccupations";
import { strings, sectorLabel } from "@/i18n/static";

const lang = "en";
const t = strings(lang);
const localeStr = "en-US";
const { es } = loadAllOccupations();
const sectors = getSectorStats(es);
const stats = getAggregateStats(es);
const sorted = [...sectors].sort((a, b) => b.avgScore - a.avgScore);

const BASE_URL = "https://empleo-ai.anlakstudio.com";

const title = t.sectorIndex.title;
const description = t.sectorIndex.description(sectors.length, es.length, stats.totalEmployment.toLocaleString(localeStr));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.sectorIndex.jsonLdName,
  "inLanguage": lang,
  "numberOfItems": sectors.length,
  "itemListElement": sorted.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${BASE_URL}${t.paths.sectorPrefix}/${sectorSlugFor(s.sector, lang)}`,
    "name": sectorLabel(s.sector, lang),
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd} lang={lang} altLangHref="/sector/">
  <SectorIndexPage lang={lang} />
</Base>
