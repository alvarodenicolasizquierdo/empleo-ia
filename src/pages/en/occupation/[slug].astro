---
import Base from "../../../layouts/Base.astro";
import OccupationDetailPage from "../../../components/astro/OccupationDetailPage.astro";
import { loadAllOccupations, occupationSlugFor } from "@/data/loadOccupations";
import { strings, sectorLabel } from "@/i18n/static";

const lang = "en";
const t = strings(lang);
const localeStr = "en-US";

export async function getStaticPaths() {
  const { es, enByCno } = loadAllOccupations();
  return es.map((occ) => ({
    params: { slug: occupationSlugFor(occ, enByCno.get(occ.cno), "en") },
    props: {
      occ,
      en: enByCno.get(occ.cno)!,
      altSlug: occupationSlugFor(occ, enByCno.get(occ.cno), "es"),
    },
  }));
}

const { occ, en, altSlug } = Astro.props;
const score = occ.vulnerabilidad_ia_score;
const scoreFmt = score.toString();
const sectorName = sectorLabel(occ.sector, lang);
const occName = en.nombre;

const title = `${occName} ${t.occupation.titleSuffix(scoreFmt)}`;
const description = t.occupation.description(
  occName, occ.cno, scoreFmt,
  occ.empleo.toLocaleString(localeStr),
  occ.salario_medio_eur.toLocaleString(localeStr),
  sectorName,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Occupation",
  "name": occName,
  "alternateName": occ.nombre,
  "occupationalCategory": `CNO-11:${occ.cno}`,
  "description": en.justificacion,
  "inLanguage": lang,
  "estimatedSalary": {
    "@type": "MonetaryAmountDistribution",
    "name": "Average annual salary",
    "currency": "EUR",
    "median": occ.salario_medio_eur,
  },
  "occupationLocation": { "@type": "Country", "name": "Spain" },
  "mainEntityOfPage": Astro.url.href,
};
---

<Base title={title} description={description} jsonLd={jsonLd} lang={lang} altLangHref={`/ocupacion/${altSlug}`}>
  <OccupationDetailPage occ={occ} en={en} lang={lang} />
</Base>
